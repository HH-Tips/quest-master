# OUTPUTS
OUT_METRICS_PDDL_GENERATION=db/metrics/pddl_generation.json
OUT_PDDL_FAULTY_FMT=db/outputs/pddls/faulty/{day}/{err}_{time}_r{regen}_it{iter}.pddl
OUT_PDDL_FMT=db/outputs/pddls/{day}/{title}_{time}.pddl
OUT_FINALIZED_LORE=db/outputs/lores/{day}/lore_{title}_{time}.txt
OUT_HTML_FMT=db/outputs/html/{day}/{title}_{time}.html

# MODELS
DEFAULT_MODEL='gemini-flash-latest'
FALLBACK_MODELS='["gemini-3.7-flash", "gemini-3.6-flash", "gemini-3.5-flash", "gemini-3-flash-preview", "gemini-2.5-flash", "gemini-3.1-flash-lite", "gemini-3.1-flash-lite-preview", "gemma-4-31b-it", "gemma-4-26b-a4b-it"]'