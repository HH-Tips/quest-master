# DOCKER
DOCKER="docker" # INSERIRE IL PATH DI DOCKER IN WINDOWS, SU LINUX VA BENE COSÌ O `podman` SE SI VUOLE USARE PODMAN.

# OPENAI API BASE URL
GOOGLE_API_KEY="" # API KEY DI GOOGLE AI STUDIO
OPENAI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai

# TEMPLATES
BASE_HTML=db/templates/html/game_template.html

# EXAMPLES
EX_PDDL_BLOCK_WORLD=db/examples/pddl/blocks_world.pddl
EX_PDDL_ZENO_TRAVEL=db/examples/pddl/zeno_travel.pddl
EX_PDDL_MUSEUM_HEIST=db/examples/pddl/museum_heist.pddl
EX_JSON_MUSEUM_HEIST=db/examples/json/museum_heist.json

# SYSTEM PROMPTS
SP_STORY_GENERATOR=db/system_prompts/lore_refinement.txt
SP_PDDL_DOMAIN_GENERATOR=db/system_prompts/pddl_domain_generation.txt
SP_PDDL_PROBLEM_GENERATOR=db/system_prompts/pddl_problem_generation.txt
SP_PDDL_FIX_SYNTAX=db/system_prompts/fix_syntax_pddl.txt
SP_PDDL_FIX_DOMAIN_SYNTAX=db/system_prompts/fix_domain_syntax_pddl.txt
SP_PDDL_FIX_PROBLEM_SYNTAX=db/system_prompts/fix_problem_syntax_pddl.txt
SP_PDDL_ADD_SOLUTION=db/system_prompts/pddl_add_solution.txt
SP_PDDL_SUGGEST=db/system_prompts/suggest_prompt.txt
